<Window x:Class="AIVision.Presentation.Wpf.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIVision.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="AIVision"
        Width="1400"
        Height="820"
        MinWidth="1280"
        MinHeight="720"
        Background="{StaticResource BackgroundGrayBrush}"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:ShellViewModel, IsDesignTimeCreatable=False}">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+Space" Command="{Binding OpenCameraCommand}" />
        <KeyBinding Key="F5" Command="{Binding StartCommand}" />
        <KeyBinding Key="F6" Command="{Binding StopCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <!-- Top Bar (簡化版，移除產品名稱和工單) -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左側選單 - 黑色文字 -->
                <Menu VerticalAlignment="Stretch" Background="Transparent" Foreground="#333333">
                    <MenuItem Header="系統" Foreground="#333333">
                        <MenuItem Header="工單管理" Command="{Binding OpenWorkOrderManagementCommand}" />
                        <Separator Visibility="{Binding IsEngineerOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <MenuItem Header="模型管理" Command="{Binding OpenModelManagementCommand}"
                                  Visibility="{Binding IsEngineerOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Separator />
                        <MenuItem Header="離開" Command="{Binding ExitCommand}" />
                    </MenuItem>
                    <MenuItem Header="使用者" Foreground="#333333">
                        <MenuItem Header="登入" Command="{Binding OpenLoginCommand}" />
                        <MenuItem Header="登出" Command="{Binding LogoutCommand}" />
                    </MenuItem>
                    <MenuItem Header="面板" Foreground="#333333">
                        <MenuItem Header="工單管理" Command="{Binding OpenWorkOrderManagementCommand}" />
                        <Separator Visibility="{Binding IsEngineerOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <!-- 需要工程師權限的面板 -->
                        <MenuItem Header="Line Scan 面板" Command="{Binding OpenLineScanCommand}"
                                  Visibility="{Binding IsEngineerOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <MenuItem Header="光源控制器" Command="{Binding OpenLightSerialControlCommand}"
                                  Visibility="{Binding IsEngineerOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <MenuItem Header="PLC 連線控制" Command="{Binding OpenIoPanelCommand}"
                                  Visibility="{Binding IsEngineerOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Separator Visibility="{Binding IsEngineerOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <MenuItem Header="模型管理" Command="{Binding OpenModelManagementCommand}"
                                  Visibility="{Binding IsEngineerOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Separator Visibility="{Binding IsEngineerOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <MenuItem Header="歷史圖庫" Command="{Binding OpenHistoryCommand}"
                                  Visibility="{Binding IsEngineerOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <MenuItem Header="批量推論" Command="{Binding OpenBatchInferenceCommand}"
                                  Visibility="{Binding IsEngineerOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <MenuItem Header="生產統計" Command="{Binding OpenProductionStatsCommand}"
                                  Visibility="{Binding IsEngineerOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Separator Visibility="{Binding IsEngineerOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <MenuItem Header="Offline 測試模式" Command="{Binding OpenOfflineTestCommand}"
                                  Visibility="{Binding IsEngineerOrAbove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Separator Visibility="{Binding IsVendor, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <MenuItem Header="[開發] 新增測試檢測記錄" Command="{Binding TestAddInspectionCommand}"
                                  Visibility="{Binding IsVendor, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </MenuItem>
                </Menu>

                <!-- 右側：專案載入 + 硬體狀態燈 + 模型狀態 + 使用者資訊 + Logo -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <!-- 載入專案按鈕 -->
                    <Button Content="載入專案"
                            Command="{Binding OpenProjectSelectCommand}"
                            Margin="0,0,16,0"
                            Padding="10,6"
                            FontSize="12"
                            Background="#FF2196F3"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF1976D2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 硬體狀態燈 -->
                    <Border Background="#FF2D2D30"
                            CornerRadius="4"
                            Padding="10,6"
                            Margin="0,0,16,0"
                            BorderBrush="#FF3F3F46"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <!-- PLC 狀態 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" ToolTip="{Binding PlcStatusTooltip}">
                                <Ellipse Width="12" Height="12"
                                         Fill="{Binding PlcStatusColor}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="PLC"
                                           FontSize="11"
                                           Foreground="White"
                                           FontWeight="Medium"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- 相機狀態 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" ToolTip="{Binding CameraStatusTooltip}">
                                <Ellipse Width="12" Height="12"
                                         Fill="{Binding CameraStatusColor}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="CAM"
                                           FontSize="11"
                                           Foreground="White"
                                           FontWeight="Medium"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- 光源狀態 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" ToolTip="{Binding LightStatusTooltip}">
                                <Ellipse Width="12" Height="12"
                                         Fill="{Binding LightStatusColor}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="LIGHT"
                                           FontSize="11"
                                           Foreground="White"
                                           FontWeight="Medium"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- AI 模型狀態 -->
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding AiModelStatusTooltip}">
                                <Ellipse Width="12" Height="12"
                                         Fill="{Binding AiModelStatusColor}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="AI"
                                           FontSize="11"
                                           Foreground="White"
                                           FontWeight="Medium"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 目前專案名稱 -->
                    <Border Background="#FF2D2D30"
                            CornerRadius="4"
                            Padding="10,6"
                            Margin="0,0,16,0"
                            BorderBrush="#FF3F3F46"
                            BorderThickness="1">
                        <TextBlock Text="{Binding CurrentProjectName, FallbackValue='未載入專案'}"
                                   FontSize="11"
                                   Foreground="White"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   ToolTip="目前載入的專案">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentProjectName}" Value="{x:Null}">
                                            <Setter Property="Text" Value="未載入專案" />
                                            <Setter Property="Foreground" Value="#FFAAAAAA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- 模型狀態 -->
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding CurrentModelName}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="#333333"
                                 Margin="0,0,0,2" />
                        <Button Content="{Binding ModelStateText}"
                                Command="{Binding ToggleModelCommand}"
                                Padding="8,4">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                                    <Setter Property="Background" Value="{StaticResource NgRedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModelLoaded}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource OkGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <!-- 使用者資訊 -->
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding CurrentUserDisplay}" FontSize="11" Foreground="#333333" />
                        <TextBlock Text="{Binding CurrentTimeDisplay}" FontSize="10" Foreground="#666666" />
                    </StackPanel>
                    <!-- 公司 Logo -->
                    <Border VerticalAlignment="Center"
                            Padding="8,4"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1,0,0,0">
                        <Image Source="/Assets/logo.png"
                               Height="40"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               ToolTip="Spingence Inc."/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Preview Area (移除左側獨立的OK/NG欄位) -->
            <Border Grid.Column="0"
                Margin="0,0,16,0"
                CornerRadius="8"
                Background="Black">
                <Grid>
                    <!-- 影像顯示 -->
                    <Image Source="{Binding LiveBitmap}"
                       Stretch="Uniform">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LiveBitmap}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!-- 無影像時的提示 -->
                    <TextBlock Text="影像預覽"
                           Foreground="White"
                           FontSize="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LiveBitmap}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- OK/NG 狀態顯示在左上角（縮小版） -->
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="12,12,0,0"
                            CornerRadius="8"
                            BorderThickness="2"
                            Padding="8,6"
                            Background="#CC000000">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource NgRedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLastResultOk}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource OkGreenBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Ellipse Width="36" Height="36">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource NgRedBrush}" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLastResultOk}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource OkGreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding LastResultStatus}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="White" />
                            <TextBlock FontSize="10"
                                       Margin="0,2,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="White"
                                       Text="{Binding LastResultConfidence, StringFormat={}{0:P0}, TargetNullValue=''}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastResultConfidence}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Panel -->
            <StackPanel Grid.Column="1" Margin="0,0,0,0">
                <!-- 生產資訊 -->
                <Border CornerRadius="12" Background="White" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="2"
                                   Text="生產資訊"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FF444444" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Product"
                                   FontSize="14"
                                   Foreground="#FF666666"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Border Grid.Row="2"
                                Grid.Column="1"
                                Background="#FFEEF4FB"
                                BorderBrush="#FFD0D7E2"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6">
                            <TextBlock Text="{Binding ProductName}" FontSize="14" />
                        </Border>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Order"
                                   FontSize="14"
                                   Foreground="#FF666666"
                                   VerticalAlignment="Center"
                                   Margin="0,6,8,0" />
                        <Border Grid.Row="3"
                                Grid.Column="1"
                                Background="#FFEEF4FB"
                                BorderBrush="#FFD0D7E2"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6"
                                Margin="0,6,0,0">
                            <TextBlock Text="{Binding OrderCode}" FontSize="14" />
                        </Border>

                        <!-- 工單管理按鈕 -->
                        <UniformGrid Grid.Row="4"
                                     Grid.ColumnSpan="2"
                                     Columns="2"
                                     Margin="0,12,0,0">
                            <Button Content="選擇工單"
                                    Command="{Binding OpenWorkOrderManagementCommand}"
                                    Margin="0,0,4,0"
                                    Padding="8,6"
                                    FontSize="13"
                                    Background="#FF2196F3"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FF1976D2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="結束工單"
                                    Command="{Binding EndCurrentWorkOrderCommand}"
                                    Margin="4,0,0,0"
                                    Padding="8,6"
                                    FontSize="13"
                                    Background="#FFFF9800"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FFE68900" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- 檢測統計 -->
                <Border CornerRadius="12" Background="#FFE3E5E8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="檢測統計"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FF333333"
                                   Margin="0,0,0,12" />
                        <UniformGrid Columns="3" Rows="1" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Total" FontSize="12" Foreground="#FF555555" />
                                <TextBlock Text="{Binding TotalCount, StringFormat=\{0\}}" FontSize="26" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="NG" FontSize="12" Foreground="#FF555555" />
                                <TextBlock Text="{Binding NgCount, StringFormat=\{0\}}" FontSize="26" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Yield" FontSize="12" Foreground="#FF555555" />
                                <TextBlock Text="{Binding YieldPercentage}" FontSize="26" FontWeight="Bold" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 缺陷統計 -->
                <Border CornerRadius="12" Background="White" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="缺陷統計"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />

                        <!-- 加上 ScrollViewer 支援捲動 -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="300">
                            <ItemsControl ItemsSource="{Binding Defects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DefectItemViewModel}">
                                        <Border CornerRadius="6"
                                                Padding="12"
                                                Background="White"
                                                BorderBrush="#FFE0E0E0"
                                                BorderThickness="1"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="1"
                                                           Text="{Binding Ratio, StringFormat={}{0:P1}}"
                                                           FontSize="14"
                                                           Foreground="#FF666666" />

                                                <StackPanel Grid.Row="1"
                                                            Grid.ColumnSpan="2"
                                                            Orientation="Horizontal"
                                                            Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Count}" FontSize="12" Foreground="#FF666666" />
                                                    <TextBlock Text="{Binding Total, StringFormat=/ {0}}" FontSize="12" Foreground="#FF666666" Margin="6,0,0,0" />
                                                    <TextBlock Text="{Binding Trend}" FontSize="12" Foreground="#FF999999" Margin="6,0,0,0" />
                                                </StackPanel>

                                                <ProgressBar Grid.Row="2"
                                                             Grid.ColumnSpan="2"
                                                             Minimum="0"
                                                             Maximum="{Binding Total, FallbackValue=1}"
                                                             Value="{Binding Count}"
                                                             Height="8"
                                                             Margin="0,8,0,0"
                                                             Foreground="{StaticResource AccentOrangeBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Bottom Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToggleButton Grid.Column="0"
                              Style="{StaticResource StartStopToggleButton}"
                              IsChecked="{Binding IsRunning, Mode=TwoWay}"
                              Command="{Binding ToggleRunCommand}"
                              CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}" />

                <!-- Run Once 按鈕已隱藏，此案不使用 -->
                <!--
                <Button Grid.Column="1"
                        Margin="16,0,0,0"
                        Style="{StaticResource ToolbarButton}"
                        Content="Run Once"
                        Command="{Binding RunOnceCommand}" />
                -->

                <!-- 右側快捷按鈕已隱藏 -->
                <!--
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="登入" Style="{StaticResource ToolbarButton}" Command="{Binding OpenLoginCommand}" />
                    <Button Content="相機面板 (Ctrl+Space)" Style="{StaticResource ToolbarButton}" Command="{Binding OpenCameraCommand}" Margin="12,0,0,0" />
                    <Button Content="歷史圖庫" Style="{StaticResource ToolbarButton}" Command="{Binding OpenHistoryCommand}" Margin="12,0,0,0" />
                    <Button Content="圖片點檢" Style="{StaticResource ToolbarButton}" Command="{Binding OpenImageBatchCommand}" Margin="12,0,0,0" />
                    <Button Content="批量推論" Style="{StaticResource ToolbarButton}" Command="{Binding OpenBatchInferenceCommand}" Margin="12,0,0,0" />
                    <Button Content="生產統計" Style="{StaticResource ToolbarButton}" Command="{Binding OpenProductionStatsCommand}" Margin="12,0,0,0" />
                </StackPanel>
                -->
            </Grid>
        </Border>
    </Grid>
</Window>
