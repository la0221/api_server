<Window x:Class="AIVision.Presentation.Wpf.Views.ModelManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIVision.Presentation.Wpf.ViewModels"
        xmlns:converters="clr-namespace:AIVision.Presentation.Wpf.Converters"
        xmlns:models="clr-namespace:AIVision.Presentation.Wpf.Models"
        mc:Ignorable="d"
        Title="模型管理"
        Width="900"
        Height="650"
        WindowStartupLocation="CenterOwner"
        Background="White"
        d:DataContext="{d:DesignInstance vm:ModelManagementViewModel, IsDesignTimeCreatable=False}">
    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:ModelTypeConverter x:Key="ModelTypeConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 標題與目前模型 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="16" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="模型管理" FontSize="24" FontWeight="Bold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="目前模型：" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentModelName}"
                                     FontSize="14"
                                     FontWeight="Bold"
                                     Foreground="#2196F3"
                                     VerticalAlignment="Center"
                                     Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="模型資料夾：" FontSize="12" VerticalAlignment="Center" Foreground="#666" />
                            <TextBlock Text="{Binding ScanFolder}"
                                     FontSize="12"
                                     Foreground="#666"
                                     VerticalAlignment="Center"
                                     Margin="8,0,0,0"
                                     TextTrimming="CharacterEllipsis"
                                     MaxWidth="500"
                                     ToolTip="{Binding ScanFolder}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="選擇模型資料夾"
                            Command="{Binding SelectScanFolderCommand}"
                            Padding="12,6"
                            VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 模型列表 -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 列表 -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Models}"
                      SelectedItem="{Binding SelectedModel}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="模型名稱" Binding="{Binding Name}" Width="*" MinWidth="120" IsReadOnly="True" />
                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" MinWidth="120" IsReadOnly="True" />
                    <DataGridTextColumn Header="模型類型" Width="80" IsReadOnly="True">
                        <DataGridTextColumn.Binding>
                            <Binding Path="ModelType">
                                <Binding.Converter>
                                    <converters:ModelTypeConverter />
                                </Binding.Converter>
                            </Binding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="EdgeHub" Binding="{Binding EdgeHubHost}" Width="120" IsReadOnly="True" />
                    <DataGridTextColumn Header="Port" Binding="{Binding EdgeHubPort}" Width="60" IsReadOnly="True" />
                    <DataGridTextColumn Header="推論 Port" Binding="{Binding EffectiveInferencePort}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="模型路徑" Binding="{Binding ModelPath}" Width="2*" MinWidth="200" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 操作按鈕 -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0" Width="120">
                <Button Content="載入模型"
                        Command="{Binding LoadSelectedModelCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="12,8"
                        Margin="0,0,0,12" />
                <Button Content="關閉服務"
                        Command="{Binding CloseServicesCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                        ToolTip="關閉 EdgeHub 上所有已載入的 AI 服務"
                        Padding="12,8"
                        Background="#FF9800"
                        Foreground="White"
                        Margin="0,0,0,12" />
                <Button Content="重新整理"
                        Command="{Binding LoadModelsCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="12,8"
                        Margin="0,0,0,12" />
                <Separator Margin="0,4,0,16" />
                <Button Content="新增模型"
                        Command="{Binding AddModelCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="12,8"
                        Margin="0,0,0,12" />
                <Button Content="編輯模型"
                        Command="{Binding EditModelCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="12,8"
                        Margin="0,0,0,12" />
                <Button Content="刪除模型"
                        Command="{Binding DeleteModelCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="12,8"
                        Background="#F44336"
                        Foreground="White"
                        Margin="0,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 狀態訊息 -->
        <Border Grid.Row="2" 
                Background="#F0F0F0" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1" 
                Padding="16"
                Margin="16,0,16,16"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="20" Height="20" 
                           IsIndeterminate="True" 
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,0,12,0" />
                <TextBlock Text="{Binding StatusMessage}" 
                         FontSize="14" 
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 關閉按鈕 -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="16" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Button Content="關閉" 
                    Width="100" 
                    HorizontalAlignment="Right"
                    Padding="12,8"
                    Click="CloseButton_Click" />
        </Border>
    </Grid>
</Window>

