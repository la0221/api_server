<Window x:Class="AIVision.Presentation.Wpf.Views.ProductionStatsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIVision.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="生產統計"
        Width="1280"
        Height="780"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundGrayBrush}"
        d:DataContext="{d:DesignInstance vm:ProductionStatsViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filter & Order List -->
        <Border Grid.Row="0"
                Grid.Column="0"
                CornerRadius="12"
                Padding="16"
                Background="White"
                BorderBrush="#FFE0E0E0"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="查詢條件"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#FF222222" />

                <StackPanel Orientation="Horizontal"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Stretch">
                    <DatePicker SelectedDate="{Binding FilterStart}"
                                Margin="0,0,8,0"
                                Width="150" />
                    <DatePicker SelectedDate="{Binding FilterEnd}"
                                Width="150" />
                </StackPanel>

                <TextBox Text="{Binding FilterProduct}"
                         Margin="0,8,0,0"
                         Width="300"
                         Height="32"
                         Padding="6"
                         BorderBrush="#FFC0C0C0"
                         BorderThickness="1"
                         ToolTip="Product" />
                <TextBox Text="{Binding FilterOrder}"
                         Margin="0,8,0,12"
                         Width="300"
                         Height="32"
                         Padding="6"
                         BorderBrush="#FFC0C0C0"
                         BorderThickness="1"
                         ToolTip="Order" />
                <Button Content="查詢"
                        Command="{Binding QueryCommand}"
                        Height="36"
                        Width="120"
                        HorizontalAlignment="Left" />

                <TextBlock Text="{Binding StatusMessage}"
                           Margin="0,12,0,4"
                           Foreground="#FF666666"
                           TextWrapping="Wrap" />
                <DataGrid ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          SelectionChanged="OnOrdersSelectionChanged"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          Height="Auto"
                          MinHeight="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="工單"
                                            Binding="{Binding Code}"
                                            Width="*" />
                        <DataGridTextColumn Header="產品"
                                            Binding="{Binding Product}"
                                            Width="120" />
                        <DataGridTextColumn Header="開始"
                                            Binding="{Binding StartAt, StringFormat=yyyy/MM/dd HH:mm}"
                                            Width="160" />
                        <DataGridTextColumn Header="結束"
                                            Binding="{Binding EndAt, StringFormat=yyyy/MM/dd HH:mm}"
                                            Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Summary & Defects -->
        <ScrollViewer Grid.Row="0"
                      Grid.Column="1"
                      Margin="16,0,0,0">
            <StackPanel>
                <Border Background="White"
                        CornerRadius="12"
                        Padding="16"
                        BorderBrush="#FFE0E0E0"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="工單摘要"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#FF222222" />
                        <ItemsControl ItemsSource="{Binding SummaryFields}"
                                      Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding LabelWidth, TargetNullValue=220}" />
                                            <ColumnDefinition Width="{Binding ValueWidth, TargetNullValue=*}" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FF555555" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FormattedValue}"
                                                   Foreground="#FF222222" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,16,0,0"
                        BorderBrush="#FFE0E0E0"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="缺陷統計"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#FF222222" />

                        <ItemsControl ItemsSource="{Binding DefectRows}"
                                      Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FF555555" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Count}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Ratio, StringFormat={}{0:P1}}"
                                                   HorizontalAlignment="Right" />
                                        <ProgressBar Grid.Column="3"
                                                     Height="12"
                                                     Minimum="0"
                                                     Maximum="1"
                                                     Value="{Binding Ratio, Mode=OneWay}"
                                                     Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="匯出 CSV"
                    Padding="18,8"
                    Command="{Binding ExportCsvCommand}" />
            <Button Content="匯出 Excel"
                    Padding="18,8"
                    Command="{Binding ExportExcelCommand}" />
        </StackPanel>
    </Grid>
</Window>
