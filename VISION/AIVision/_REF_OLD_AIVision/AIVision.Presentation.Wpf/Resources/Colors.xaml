<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PrimaryBlue">#FF1378AA</Color>
    <Color x:Key="OkGreen">#FF32CD32</Color>
    <Color x:Key="NgRed">#FFB00020</Color>
    <Color x:Key="AccentOrange">#FFFB8C00</Color>
    <Color x:Key="PanelGray">#FFE0E0E0</Color>
    <Color x:Key="BackgroundGray">#FFF2F2F2</Color>

    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlue}" />
    <SolidColorBrush x:Key="OkGreenBrush" Color="{StaticResource OkGreen}" />
    <SolidColorBrush x:Key="NgRedBrush" Color="{StaticResource NgRed}" />
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentOrange}" />
    <SolidColorBrush x:Key="PanelGrayBrush" Color="{StaticResource PanelGray}" />
    <SolidColorBrush x:Key="BackgroundGrayBrush" Color="{StaticResource BackgroundGray}" />
</ResourceDictionary>
