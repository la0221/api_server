<Window x:Class="AIVision.Presentation.Wpf.Views.RecognitionProcessView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="辨識過程視覺化" Height="760" Width="1180"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E">
    <DockPanel Margin="14">

        <!-- 結果橫幅 -->
        <Border DockPanel.Dock="Top" Background="#252526" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding FileName}" Foreground="#9CDCFE" FontSize="12"/>
                <TextBlock Text="{Binding ResultText}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 三階段流程 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ① 原圖 + Hough 圓 + ROI -->
            <Border Grid.Column="0" Background="#252526" CornerRadius="6" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="① 原圖：Hough 找鏡片外環 (綠) + 方框 ROI (黃)"
                               Foreground="#D4D4D4" FontSize="12" Margin="2,0,2,6"/>
                    <Image Source="{Binding OriginalAnnotated}" Stretch="Uniform"/>
                </DockPanel>
            </Border>
            <TextBlock Grid.Column="1" Text="→" Foreground="#0E639C" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- ② warpPolar 字帶 -->
            <Border Grid.Column="2" Background="#252526" CornerRadius="6" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="② warpPolar 展開的環狀字帶"
                               Foreground="#D4D4D4" FontSize="12" Margin="2,0,2,6"/>
                    <Image Source="{Binding PolarStrip}" Stretch="Uniform"/>
                </DockPanel>
            </Border>
            <TextBlock Grid.Column="3" Text="→" Foreground="#0E639C" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- ③ 模型輸入 -->
            <Border Grid.Column="4" Background="#252526" CornerRadius="6" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="③ 白底 letterbox → 模型輸入"
                               Foreground="#D4D4D4" FontSize="12" Margin="2,0,2,6"/>
                    <Image Source="{Binding ModelInput}" Stretch="Uniform"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
