<Window x:Class="AIVision.Presentation.Wpf.Views.OfflineTestView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIVision.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Offline 測試模式"
        Width="1400"
        Height="820"
        MinWidth="1280"
        MinHeight="720"
        Background="{StaticResource BackgroundGrayBrush}"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:OfflineTestViewModel, IsDesignTimeCreatable=False}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <TextBlock Text="Offline 測試模式"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Preview Area -->
            <Border Grid.Column="0"
                Margin="0,0,16,0"
                CornerRadius="8"
                Background="Black">
                <Grid>
                    <!-- 影像顯示 -->
                    <Image x:Name="CurrentImage"
                       Stretch="Uniform">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentImagePath}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!-- 無影像時的提示 -->
                    <TextBlock Text="請選擇資料夾載入影像"
                           Foreground="White"
                           FontSize="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentImagePath}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- OK/NG 狀態顯示在左上角 -->
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="12,12,0,0"
                            CornerRadius="8"
                            BorderThickness="2"
                            Padding="8,6"
                            Background="#CC000000">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="BorderBrush" Value="{StaticResource NgRedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastResult}" Value="OK">
                                        <Setter Property="BorderBrush" Value="{StaticResource OkGreenBrush}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LastResult}" Value="NG">
                                        <Setter Property="BorderBrush" Value="{StaticResource NgRedBrush}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Ellipse Width="36" Height="36">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource NgRedBrush}" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastResult}" Value="OK">
                                                <Setter Property="Fill" Value="{StaticResource OkGreenBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding LastResult}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="White" />
                            <TextBlock FontSize="10"
                                       Margin="0,2,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="White"
                                       Text="{Binding LastConfidence, StringFormat={}{0:P0}, TargetNullValue=''}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastConfidence}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 影像計數顯示在右上角 -->
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,12,12,0"
                            CornerRadius="8"
                            Padding="12,8"
                            Background="#CC000000">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalImages}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding TotalImages, Converter={x:Null}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="White" FontSize="14" FontWeight="SemiBold">
                            <Run Text="{Binding CurrentImageIndex, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{Binding TotalImages, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Panel -->
            <StackPanel Grid.Column="1" Margin="0,0,0,0">
                <!-- 測試資訊 -->
                <Border CornerRadius="12" Background="White" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="2"
                                   Text="測試資訊"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FF444444" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Folder"
                                   FontSize="14"
                                   Foreground="#FF666666"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Border Grid.Row="2"
                                Grid.Column="1"
                                Background="#FFEEF4FB"
                                BorderBrush="#FFD0D7E2"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6">
                            <TextBlock Text="{Binding SelectedFolder, TargetNullValue='未選擇'}"
                                       FontSize="14"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedFolder}" />
                        </Border>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Order"
                                   FontSize="14"
                                   Foreground="#FF666666"
                                   VerticalAlignment="Center"
                                   Margin="0,6,8,0" />
                        <Border Grid.Row="3"
                                Grid.Column="1"
                                Background="#FFEEF4FB"
                                BorderBrush="#FFD0D7E2"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6"
                                Margin="0,6,0,0">
                            <TextBlock Text="{Binding SelectedWorkOrderName, TargetNullValue='未選擇'}" FontSize="14" />
                        </Border>

                        <!-- 選擇按鈕 -->
                        <UniformGrid Grid.Row="4"
                                     Grid.ColumnSpan="2"
                                     Columns="2"
                                     Margin="0,12,0,0">
                            <Button Content="選擇資料夾"
                                    Command="{Binding SelectFolderCommand}"
                                    Margin="0,0,4,0"
                                    Padding="8,6"
                                    FontSize="13"
                                    Background="#FF2196F3"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FF1976D2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="選擇工單"
                                    Command="{Binding SelectWorkOrderCommand}"
                                    Margin="4,0,0,0"
                                    Padding="8,6"
                                    FontSize="13"
                                    Background="#FFFF9800"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FFE68900" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- 檢測統計 -->
                <Border CornerRadius="12" Background="#FFE3E5E8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="檢測統計"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FF333333"
                                   Margin="0,0,0,12" />
                        <UniformGrid Columns="3" Rows="1" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Total" FontSize="12" Foreground="#FF555555" />
                                <TextBlock Text="{Binding TotalCount, StringFormat=\{0\}}" FontSize="26" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="NG" FontSize="12" Foreground="#FF555555" />
                                <TextBlock Text="{Binding NgCount, StringFormat=\{0\}}" FontSize="26" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Yield" FontSize="12" Foreground="#FF555555" />
                                <TextBlock Text="{Binding YieldRate, StringFormat={}{0:P1}}" FontSize="26" FontWeight="Bold" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 缺陷統計 -->
                <Border CornerRadius="12" Background="White" Padding="16">
                    <StackPanel>
                        <TextBlock Text="缺陷統計"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding DefectStatistics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6"
                                            Padding="12"
                                            Background="White"
                                            BorderBrush="#FFE0E0E0"
                                            BorderThickness="1"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="1"
                                                       Text="{Binding Ratio, StringFormat={}{0:P1}}"
                                                       FontSize="14"
                                                       Foreground="#FF666666" />

                                            <StackPanel Grid.Row="1"
                                                        Grid.ColumnSpan="2"
                                                        Orientation="Horizontal"
                                                        Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Count}" FontSize="12" Foreground="#FF666666" />
                                                <TextBlock Text="{Binding Total, StringFormat=/ {0}}" FontSize="12" Foreground="#FF666666" Margin="6,0,0,0" />
                                            </StackPanel>

                                            <ProgressBar Grid.Row="2"
                                                         Grid.ColumnSpan="2"
                                                         Minimum="0"
                                                         Maximum="{Binding Total, FallbackValue=1}"
                                                         Value="{Binding Count}"
                                                         Height="8"
                                                         Margin="0,8,0,0"
                                                         Foreground="{StaticResource AccentOrangeBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <!-- 無缺陷時的提示 -->
                        <TextBlock Text="尚無缺陷統計資料"
                                   FontSize="14"
                                   Foreground="#FF999999"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DefectStatistics.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Bottom Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="◀ 上一張"
                            Command="{Binding MoveToPreviousCommand}"
                            Style="{StaticResource ToolbarButton}" />
                    <Button Content="▶ 下一張"
                            Command="{Binding MoveToNextCommand}"
                            Style="{StaticResource ToolbarButton}"
                            Margin="12,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="重設統計"
                            Command="{Binding ResetStatisticsCommand}"
                            Style="{StaticResource ToolbarButton}" />
                    <Button Content="觸發檢測"
                            Command="{Binding TriggerInspectionCommand}"
                            Style="{StaticResource ToolbarButton}"
                            Margin="12,0,0,0"
                            Background="#FF4CAF50"
                            Foreground="White"
                            FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
