<Window x:Class="AIVision.Presentation.Wpf.Views.OfflineModelEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIVision.Presentation.Wpf.ViewModels"
        xmlns:converters="clr-namespace:AIVision.Presentation.Wpf.Converters"
        mc:Ignorable="d"
        Title="編輯模型 (本地 ONNX)"
        Width="640"
        Height="780"
        WindowStartupLocation="CenterOwner"
        Background="White"
        ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance vm:OfflineModelEditViewModel, IsDesignTimeCreatable=False}">
    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 標題 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="編輯模型" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding ModelFileName}" FontSize="13" Foreground="#2196F3" Margin="0,4,0,0" />
            <TextBlock Text="{Binding ModelPathDisplay}"
                       FontSize="11"
                       Foreground="#888"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ModelPathDisplay}"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- 表單 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 基本 -->
                <TextBlock Text="基本" FontSize="15" FontWeight="Bold" Foreground="#333" Margin="0,0,0,8" />

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="顯示名稱" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Padding="8,6" />
                    <TextBlock Text="顯示於模型清單;留空則用檔名。" FontSize="11" Foreground="#888" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="說明 / 描述" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Padding="8,6"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="56"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="模號前綴 (CodePrefix)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding CodePrefix, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Padding="8,6" Width="200" HorizontalAlignment="Left" />
                    <TextBlock Text="分類模型只認穴號,輸出前補上前綴成完整碼(例: M101)。" FontSize="11" Foreground="#888" Margin="0,3,0,0" />
                </StackPanel>

                <!-- 進階前處理 -->
                <TextBlock Text="進階前處理" FontSize="15" FontWeight="Bold" Foreground="#333" Margin="0,8,0,8" />

                <!-- 警告 -->
                <Border BorderBrush="#FFA726" Background="#FFF8E1" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                    <TextBlock Text="{Binding PreprocessWarning}"
                               Foreground="#E65100"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Imgsz (輸入邊長)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Imgsz, UpdateSourceTrigger=LostFocus}"
                                 FontSize="13" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="OuterFactor (裁切半徑倍率)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding OuterFactor, UpdateSourceTrigger=LostFocus}"
                                 FontSize="13" Padding="8,6" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <CheckBox Content="UseBlackhat (blackhat 前處理)"
                              IsChecked="{Binding UseBlackhat}"
                              FontSize="13" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <CheckBox Content="UseLocator (圓裁切+遮罩)"
                              IsChecked="{Binding UseLocator}"
                              FontSize="13" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 只讀:類別清單 -->
                <TextBlock Text="類別清單 (只讀,來自 .names.json)" FontSize="15" FontWeight="Bold" Foreground="#333" Margin="0,8,0,8" />
                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding ClassListSummary}" FontSize="12" Foreground="#444" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 只讀:訓練/精度資訊 -->
                <TextBlock Text="訓練 / 精度資訊 (只讀)" FontSize="15" FontWeight="Bold" Foreground="#333" Margin="0,8,0,8" />
                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <TextBlock Text="{Binding TrainingInfo}" FontSize="12" Foreground="#444" TextWrapping="Wrap" />
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 錯誤訊息 -->
        <Border Grid.Row="2"
                Background="#FFEBEE"
                BorderBrush="#F44336"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,12,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="13" TextWrapping="Wrap" />
        </Border>

        <!-- 按鈕 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消"
                    Width="100" Padding="12,8" Margin="0,0,12,0"
                    Command="{Binding CancelCommand}" />
            <Button Content="儲存"
                    Width="100" Padding="12,8"
                    Background="#2196F3" Foreground="White"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>
