<Window x:Class="AIVision.Presentation.Wpf.Views.WorkOrderInputView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIVision.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="520"
        Height="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundGrayBrush}"
        ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance vm:WorkOrderInputViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 標題 -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <!-- 表單 -->
        <Border Grid.Row="1"
                CornerRadius="8"
                Background="White"
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 產品名稱 -->
                <TextBlock Text="產品名稱 *"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBox Text="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="8"
                         Margin="0,0,0,16">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderBrush" Value="#FFD0D7E2" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#FF2196F3" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- 工單編號 -->
                <TextBlock Text="工單編號（選填，空白則自動產生）"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBox Text="{Binding WorkOrderCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsCodeReadOnly}"
                         FontSize="14"
                         Padding="8"
                         Margin="0,0,0,4">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderBrush" Value="#FFD0D7E2" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#FF2196F3" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="（格式範例：WO-20251122-001）"
                           FontSize="11"
                           Foreground="#FF999999"
                           Margin="0,4,0,16" />

                <!-- 預期模號（模號核對用）— 從目前載入的雙 head 模型類別選，免手打 -->
                <TextBlock Text="預期模號 / 穴號（選填，選「不核對」則不核對）"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding MohaoOptions}"
                              SelectedItem="{Binding SelectedMohao, Mode=TwoWay}"
                              FontSize="14" Padding="8"
                              ToolTip="預期模號（來自目前載入模型）" />
                    <TextBlock Grid.Column="1" Text="/" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF666666" />
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding XuehaoOptions}"
                              SelectedItem="{Binding SelectedXuehao, Mode=TwoWay}"
                              FontSize="14" Padding="8"
                              ToolTip="預期穴號（來自目前載入模型）" />
                </Grid>
                <TextBlock Text="{Binding PairModelHint}"
                           FontSize="11"
                           Foreground="#FF999999"
                           TextWrapping="Wrap"
                           Margin="0,4,0,16" />

                <!-- 批次號 -->
                <TextBlock Text="批次號（選填）"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <TextBox Text="{Binding BatchNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="8"
                         Margin="0,0,0,16">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderBrush" Value="#FFD0D7E2" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#FF2196F3" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- AI 模型選擇 -->
                <TextBlock Text="AI 模型 / Workflow（選填；模號穴號核對走雙 head）"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding AvailableModels}"
                          SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                          DisplayMemberPath="DisplayNameWithType"
                          Style="{StaticResource LightComboBoxStyle}"
                          FontSize="14"
                          Margin="0,0,0,4"/>
                <TextBlock Text="（不同模型有不同的瑕疵項目數目和種類）"
                           FontSize="11"
                           Foreground="#FF999999"
                           Margin="0,4,0,0" />
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 錯誤訊息（浮層：覆蓋於表單頂端，不佔版面、不擠壓欄位） -->
        <Border Grid.Row="1"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Panel.ZIndex="10"
                Background="#FFFFEBEE"
                BorderBrush="#FFF44336"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="8"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect Color="#33000000" BlurRadius="8" ShadowDepth="2" />
            </Border.Effect>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#FFF44336"
                       TextWrapping="Wrap" />
        </Border>

        <!-- 按鈕列 -->
        <UniformGrid Grid.Row="2"
                     Columns="3"
                     Margin="0,16,0,0">
            <Button Content="取消"
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                    Margin="0,0,4,0"
                    Padding="12,8"
                    FontSize="14"
                    Background="#FFE0E0E0"
                    Foreground="#FF333333"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFD0D0D0" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="結束當前工單"
                    Command="{Binding EndCurrentWorkOrderCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                    Margin="4,0,4,0"
                    Padding="12,8"
                    FontSize="14"
                    Background="#FFFF9800"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFE68900" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="確認創建"
                    Command="{Binding ConfirmCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                    Margin="4,0,0,0"
                    Padding="12,8"
                    FontSize="14"
                    Background="#FF4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF45A049" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </UniformGrid>

        <!-- 載入中遮罩 -->
        <Grid Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="創建中..."
                           FontSize="16"
                           Foreground="White"
                           FontWeight="Bold" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
