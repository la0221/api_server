<Window x:Class="AIVision.Presentation.Wpf.Views.ModelSelectView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIVision.Presentation.Wpf.ViewModels"
        xmlns:converters="clr-namespace:AIVision.Presentation.Wpf.Converters"
        xmlns:models="clr-namespace:AIVision.Presentation.Wpf.Models"
        mc:Ignorable="d"
        Title="選擇模型"
        Width="700"
        Height="500"
        WindowStartupLocation="CenterOwner"
        Background="White"
        d:DataContext="{d:DesignInstance vm:ModelSelectViewModel, IsDesignTimeCreatable=False}">
    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:ModelTypeConverter x:Key="ModelTypeConverter" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 標題 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="選擇模型版本" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="目前模型：" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentModelName}" 
                         FontSize="14" 
                         FontWeight="Bold" 
                         Foreground="#2196F3"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- 模型列表 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Models}"
                  SelectedItem="{Binding SelectedModel}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="模型名稱" Binding="{Binding Name}" Width="*" MinWidth="120" IsReadOnly="True" />
                <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" MinWidth="120" IsReadOnly="True" />
                <DataGridTextColumn Header="模型類型" Width="80" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <Binding Path="ModelType">
                            <Binding.Converter>
                                <converters:ModelTypeConverter />
                            </Binding.Converter>
                        </Binding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="EdgeHub" Binding="{Binding EdgeHubHost}" Width="120" IsReadOnly="True" />
                <DataGridTextColumn Header="推論 Port" Binding="{Binding InferencePort}" Width="80" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 狀態訊息 -->
        <Border Grid.Row="2" 
                Background="#F0F0F0" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1" 
                Padding="16"
                Margin="0,16,0,16"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="20" Height="20" 
                           IsIndeterminate="True" 
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,0,12,0" />
                <TextBlock Text="{Binding StatusMessage}" 
                         FontSize="14" 
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 按鈕 -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="取消"
                    Width="100"
                    Padding="12,8"
                    Margin="0,0,12,0"
                    Command="{Binding CancelCommand}"
                    Click="CancelButton_Click" />
            <Button Content="載入模型"
                    Width="120"
                    Padding="12,8"
                    Background="#2196F3"
                    Foreground="White"
                    Command="{Binding LoadSelectedModelCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}" />
        </StackPanel>
    </Grid>
</Window>

