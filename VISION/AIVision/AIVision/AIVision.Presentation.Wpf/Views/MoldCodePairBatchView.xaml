<Window x:Class="AIVision.Presentation.Wpf.Views.MoldCodePairBatchView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模號 + 穴號 雙 head 模型管理 / 離線測試" Height="900" Width="1120"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E">
    <DockPanel Margin="14">

        <!-- ① 模型管理 -->
        <Border DockPanel.Dock="Top" Background="#252526" CornerRadius="6" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="目前模型版本：" Foreground="#9CDCFE" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentVersionName, TargetNullValue='（尚未載入）'}"
                               Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <WrapPanel>
                    <TextBlock Text="① 版本" Foreground="#D4D4D4" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding AvailableVersions}"
                              SelectedItem="{Binding SelectedVersion}"
                              DisplayMemberPath="Name"
                              IsEnabled="{Binding NotRunning}"
                              Width="170" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Button Content="載入為目前模型" Command="{Binding LoadModelCommand}"
                            IsEnabled="{Binding NotRunning}" Padding="16,6" Margin="0,0,8,0"
                            Background="#0E639C" Foreground="White" BorderThickness="0"/>
                    <Button Content="重新整理" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding NotRunning}" Padding="12,6" Margin="0,0,8,0"
                            Background="#3A3D41" Foreground="#D4D4D4" BorderThickness="0"/>
                    <Button Content="下一步：批量推論 →" Command="{Binding GoBatchInferenceCommand}"
                            IsEnabled="{Binding HasModelLoaded}" Padding="14,6"
                            Background="#2D7D46" Foreground="White" BorderThickness="0"
                            ToolTip="沿用目前載入的版本，前往批量推論做工單核對並寫入歷史"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ①-5 中央推論（API server）驗收 —— 只驗「路通不通」，不影響上方本機辨識 -->
        <Border DockPanel.Dock="Top" Background="#252526" CornerRadius="6" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="推論來源：" Foreground="#9CDCFE" FontSize="13" VerticalAlignment="Center"/>
                    <RadioButton Content="本機 ONNX" GroupName="InferSource" IsChecked="True"
                                 IsEnabled="{Binding NotRunning}" Foreground="White" FontWeight="Bold"
                                 VerticalAlignment="Center" Margin="4,0,14,0"/>
                    <RadioButton Content="中央伺服器" GroupName="InferSource"
                                 IsChecked="{Binding UseRemoteSource, Mode=TwoWay}"
                                 IsEnabled="{Binding NotRunning}" Foreground="White" FontWeight="Bold"
                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="（批量辨識依此來源執行；中央＝隔離試模，不需也不動本地模型；生產辨識不受影響）"
                               Foreground="#808080" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
                <WrapPanel>
                    <Button Content="測試中央推論" Command="{Binding TestCentralInferenceCommand}"
                            IsEnabled="{Binding NotTestingServer}" Padding="16,6" Margin="0,0,12,0"
                            Background="#6A4CA0" Foreground="White" BorderThickness="0"
                            ToolTip="① 健康檢查 → ② 送一張測試圖驗讀值與延遲。用來確認 API server 是否打通。"/>
                    <TextBlock Text="Server：" Foreground="#D4D4D4" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ServerBaseUrl, TargetNullValue='（未設定）'}"
                               Foreground="#D4D4D4" VerticalAlignment="Center"
                               MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="伺服器模型版本：" Foreground="#D4D4D4"
                               VerticalAlignment="Center" Margin="14,0,4,0"/>
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding ServerVersionOptions}"
                              Text="{Binding ServerModelVersion, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding NotRunning}"
                              Width="140" VerticalAlignment="Center" Margin="0,0,6,0"
                              ToolTip="留空 = server 現用版本。指定版本＝隔離試模：新模型只放 server，本地不下載不污染。先按「查伺服器版本」帶出清單。"/>
                    <Button Content="查伺服器版本" Command="{Binding FetchServerVersionsCommand}"
                            IsEnabled="{Binding NotRunning}" Padding="10,6"
                            Background="#3E3E42" Foreground="White" BorderThickness="0"
                            ToolTip="向 server 要登錄夾版本清單（GET /api/models），填入左邊下拉。"/>
                </WrapPanel>
                <Border Background="#1B1B1B" CornerRadius="4" Padding="10" Margin="0,8,0,0"
                        Visibility="{Binding ServerTestResult, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding ServerTestResult}" Foreground="#4EC9B0"
                               TextWrapping="Wrap" FontSize="13" FontFamily="Consolas"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ② 離線測試工具列（WrapPanel：視窗變窄時自動換行，按鈕不會被擠出畫面）-->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="② 測試" Foreground="#D4D4D4" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="選擇測試影像資料夾" Command="{Binding PickFolderCommand}"
                    IsEnabled="{Binding NotRunning}" Padding="14,6" Margin="0,0,8,8"/>
            <!-- 可編輯下拉：預設常用測試資料夾（appsettings TestImageFolders）＋可直接貼任意路徑 -->
            <ComboBox IsEditable="True"
                      ItemsSource="{Binding TestFolderOptions}"
                      Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding NotRunning}"
                      Width="460" VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip="從下拉選常用測試資料夾，或直接貼上任意路徑（清單可在 appsettings 的 TestImageFolders 增修）"/>
            <CheckBox Content="子資料夾名當穴號正解"
                      IsChecked="{Binding UseSubfolderAsGroundTruth}"
                      Foreground="#D4D4D4" VerticalAlignment="Center" Margin="10,0"/>
            <CheckBox Content="逐張播放辨識過程"
                      IsChecked="{Binding PlaybackEnabled}"
                      Foreground="#D4D4D4" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <CheckBox Content="套用相機ROI(全幅原圖才勾)"
                      IsChecked="{Binding ApplyCameraRoi}"
                      IsEnabled="{Binding UseRemoteSource, Converter={StaticResource InverseBooleanConverter}}"
                      ToolTip="來源=中央伺服器時不適用：server 收已裁圖（Roi=0），此勾選只影響本機來源。"
                      Foreground="#D4D4D4" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="執行批量辨識" Command="{Binding RunBatchCommand}"
                    IsEnabled="{Binding NotRunning}" Padding="14,6" Margin="0,0,8,0"
                    Background="#0E639C" Foreground="White" BorderThickness="0"/>
            <Button Content="停止" Command="{Binding StopCommand}"
                    IsEnabled="{Binding IsRunning}" Padding="14,6"
                    Background="#A1260D" Foreground="White" BorderThickness="0"/>
        </WrapPanel>

        <!-- 辨識過程：逐張圓圖 + 結果（自動下一張） -->
        <Border DockPanel.Dock="Top" Background="#252526" CornerRadius="6" Padding="10" Margin="0,0,0,10"
                Height="300">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="辨識過程（逐張：原圖 + Hough 圓 + ROI；執行時自動播放）"
                           Foreground="#D4D4D4" FontSize="12" Margin="2,0,2,6"/>
                <Border DockPanel.Dock="Bottom" Background="#1B1B1B" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                    <TextBlock Text="{Binding CurrentResultText, TargetNullValue=''}"
                               Foreground="#4EC9B0" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>
                <Image Source="{Binding CurrentPreview}" Stretch="Uniform"/>
            </DockPanel>
        </Border>

        <!-- 狀態 -->
        <Border DockPanel.Dock="Bottom" Background="#252526" Padding="10" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#9CDCFE" TextWrapping="Wrap" FontSize="13"/>
        </Border>

        <!-- 結果表（雙軸）— 雙擊某列開啟辨識過程視覺化 -->
        <DataGrid x:Name="ResultsGrid"
                  ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="#3F3F46"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  RowBackground="#2D2D30" AlternatingRowBackground="#252526"
                  CanUserAddRows="False" SelectionMode="Single"
                  MouseDoubleClick="ResultsGrid_MouseDoubleClick"
                  ToolTip="雙擊某列可開啟「辨識過程視覺化」">
            <DataGrid.Columns>
                <DataGridTextColumn Header="檔案" Binding="{Binding File}" Width="2*"/>
                <DataGridTextColumn Header="預期模號" Binding="{Binding ExpectedMohao}" Width="*"/>
                <DataGridTextColumn Header="讀到模號" Binding="{Binding ReadMohao}" Width="*"/>
                <DataGridTextColumn Header="模號信心" Binding="{Binding ConfMohao, StringFormat=F3}" Width="0.8*"/>
                <DataGridTextColumn Header="模號相符" Binding="{Binding MohaoMatch}" Width="0.7*"/>
                <DataGridTextColumn Header="預期穴號" Binding="{Binding ExpectedXuehao}" Width="0.8*"/>
                <DataGridTextColumn Header="讀到穴號" Binding="{Binding ReadXuehao}" Width="0.8*"/>
                <DataGridTextColumn Header="穴號信心" Binding="{Binding ConfXuehao, StringFormat=F3}" Width="0.8*"/>
                <DataGridTextColumn Header="穴號相符" Binding="{Binding XuehaoMatch}" Width="0.7*"/>
                <DataGridTextColumn Header="雙軸皆對" Binding="{Binding BothMatch}" Width="0.7*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
