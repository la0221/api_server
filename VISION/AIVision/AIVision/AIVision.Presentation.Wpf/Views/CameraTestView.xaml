<Window x:Class="AIVision.Presentation.Wpf.Views.CameraTestView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:AIVision.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="IDS Peak 相機測試面板"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:CameraTestViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 標題 -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="IDS Peak 相機測試面板"
                   FontSize="24" FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <!-- 左側：影像預覽 -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="#111"
                CornerRadius="8"
                Padding="8"
                Margin="0,0,12,12">
            <Grid>
                <Image Source="{Binding FrameBitmap}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="White"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 右側：控制面板 -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">

            <!-- 相機控制 -->
            <GroupBox Header="相機控制" Padding="4" Margin="0,0,0,4" FontSize="11">
                <StackPanel>
                    <Button Content="開啟相機"
                            Command="{Binding OpenCameraCommand}"
                            Height="28"
                            Margin="0,0,0,3"
                            FontSize="11"
                            IsEnabled="{Binding CanOpen}"/>
                    <Button Content="關閉相機"
                            Command="{Binding CloseCameraCommand}"
                            Height="28"
                            Margin="0,0,0,3"
                            FontSize="11"
                            IsEnabled="{Binding IsOpen}"/>
                    <Button Command="{Binding ToggleLinescanModeCommand}"
                            Height="28"
                            Margin="0,0,0,3"
                            FontSize="11"
                            IsEnabled="{Binding LinescanSupported}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="切換到線掃描模式"/>
                                <Setter Property="Background" Value="#E0E0E0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLinescanMode}" Value="True">
                                        <Setter Property="Content" Value="切換到面陣模式"/>
                                        <Setter Property="Background" Value="#4CAF50"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="儲存照片"
                            Command="{Binding CaptureImageCommand}"
                            Height="28"
                            FontSize="11"
                            IsEnabled="{Binding IsOpen}"/>
                </StackPanel>
            </GroupBox>

            <!-- 曝光時間 -->
            <GroupBox Header="曝光時間 (ms)" Padding="4" Margin="0,0,0,4" FontSize="11">
                <StackPanel>
                    <Grid Margin="0,0,0,1">
                        <TextBlock Text="{Binding ExposureTimeMs, StringFormat={}{0:F2}}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding ExposureRangeMs}" Foreground="Gray" FontSize="9" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="{Binding ExposureMinMs}"
                            Maximum="{Binding ExposureMaxMs}"
                            Value="{Binding ExposureTimeMs}"
                            TickFrequency="{Binding ExposureIncrementMs}"
                            IsSnapToTickEnabled="True"
                            IsEnabled="{Binding IsOpen}"
                            Height="20"/>
                </StackPanel>
            </GroupBox>

            <!-- 增益 -->
            <GroupBox Header="增益" Padding="4" Margin="0,0,0,4" FontSize="11">
                <StackPanel>
                    <Grid Margin="0,0,0,1">
                        <TextBlock Text="{Binding Gain, StringFormat={}{0:F2}}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding GainRange}" Foreground="Gray" FontSize="9" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="{Binding GainMin}"
                            Maximum="{Binding GainMax}"
                            Value="{Binding Gain}"
                            TickFrequency="{Binding GainIncrement}"
                            IsSnapToTickEnabled="True"
                            IsEnabled="{Binding IsOpen}"
                            Height="20"/>
                </StackPanel>
            </GroupBox>

            <!-- 高度 -->
            <GroupBox Header="影像高度 (px)" Padding="4" Margin="0,0,0,4" FontSize="11">
                <StackPanel>
                    <Grid Margin="0,0,0,1">
                        <TextBlock Text="{Binding Height}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding HeightRange}" Foreground="Gray" FontSize="9" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="{Binding HeightMin}"
                            Maximum="{Binding HeightMax}"
                            Value="{Binding Height}"
                            TickFrequency="{Binding HeightIncrement}"
                            IsSnapToTickEnabled="True"
                            IsEnabled="{Binding IsOpen}"
                            Height="20"/>
                </StackPanel>
            </GroupBox>

            <!-- 行掃描頻率 (Linescan only) -->
            <GroupBox Header="行掃描頻率 (Hz)" Padding="4" Margin="0,0,0,4" FontSize="11">
                <GroupBox.Style>
                    <Style TargetType="GroupBox">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLinescanMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GroupBox.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,1">
                        <TextBlock Text="{Binding LineRate, StringFormat={}{0:F1}}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding LineRateRange}" Foreground="Gray" FontSize="9" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Minimum="{Binding LineRateMin}"
                            Maximum="{Binding LineRateMax}"
                            Value="{Binding LineRate}"
                            TickFrequency="{Binding LineRateIncrement}"
                            IsSnapToTickEnabled="True"
                            IsEnabled="{Binding IsOpen}"
                            Height="20"/>
                </StackPanel>
            </GroupBox>

            <!-- 儲存設定 -->
            <GroupBox Header="儲存設定" Padding="4" Margin="0,0,0,4" FontSize="11">
                <StackPanel>
                    <Button Content="選擇儲存路徑"
                            Command="{Binding SelectSavePathCommand}"
                            Height="24"
                            FontSize="10"
                            Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding SavePath}"
                               TextWrapping="Wrap"
                               FontSize="9"
                               Foreground="Gray"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- 底部：日誌 -->
        <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="日誌" Padding="8">
            <ScrollViewer Height="120" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding LogText}"
                           FontFamily="Consolas"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>
