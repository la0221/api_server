<Window x:Class="AIVision.Presentation.Wpf.Views.BatchInferenceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIVision.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="批量推論"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundGrayBrush}"
        d:DataContext="{d:DesignInstance vm:BatchInferenceViewModel, IsDesignTimeCreatable=False}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- 預覽區域 -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Background="#FF0F0F10"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,16,12">
            <Viewbox Stretch="Uniform">
                <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" />
            </Viewbox>
        </Border>

        <!-- 統計區域 -->
        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,12">
            <!-- 當前工單卡片 -->
            <Border Background="White"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12"
                    BorderBrush="#FFE0E0E0"
                    BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <TextBlock Text="當前工單"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FF333333"
                                   VerticalAlignment="Center" />
                        <Button Content="選擇工單"
                                Command="{Binding SelectWorkOrderCommand}"
                                Margin="8,0,0,0"
                                Padding="8,4"
                                FontSize="11"
                                Background="#FF2196F3"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FF1976D2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,4">
                        <TextBlock Text="工單號："
                                   FontSize="12"
                                   Foreground="#FF666666"
                                   Margin="0,0,4,0" />
                        <TextBlock Text="{Binding CurrentWorkOrderCode}"
                                   FontSize="12"
                                   Foreground="#FF333333"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="產品名："
                                   FontSize="12"
                                   Foreground="#FF666666"
                                   Margin="0,0,4,0" />
                        <TextBlock Text="{Binding CurrentWorkOrderProduct}"
                                   FontSize="12"
                                   Foreground="#FF333333"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="預期模號（核對）："
                                   FontSize="12"
                                   Foreground="#FF666666"
                                   Margin="0,0,4,0" />
                        <TextBlock Text="{Binding ExpectedCodeDisplay}"
                                   FontSize="12"
                                   Foreground="#FF0E639C"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 當前推論結果卡片 -->
            <Border Background="#FFF4F6FA"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,12"
                    BorderBrush="#FFE0E0E0"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="當前推論"
                               FontSize="12"
                               Foreground="#FF666666"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding CurrentLabel, FallbackValue='等待推論'}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FF333333"
                               Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="信心分數："
                                   FontSize="12"
                                   Foreground="#FF666666"
                                   Margin="0,0,4,0" />
                        <TextBlock Text="{Binding CurrentConfidence, StringFormat={}{0:P1}, FallbackValue='--'}"
                                   FontSize="12"
                                   Foreground="#FF3B82F6"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="批量統計"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#FF333333" />

            <UniformGrid Columns="3"
                         Margin="0,12,0,12">
                <Border Background="#FFF4F6FA" Padding="8" CornerRadius="8" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="已處理" FontSize="12" Foreground="#FF666666" />
                        <TextBlock Text="{Binding ProcessedCount}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#FFF4F6FA" Padding="8" CornerRadius="8" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="待處理" FontSize="12" Foreground="#FF666666" />
                        <TextBlock Text="{Binding PendingCount}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#FFF4F6FA" Padding="8" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="總張數" FontSize="12" Foreground="#FF666666" />
                        <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="12"
                    BorderBrush="#FFE0E0E0"
                    BorderThickness="1">
                <DataGrid ItemsSource="{Binding Stats}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="分類" Binding="{Binding Label}" Width="*" />
                        <DataGridTextColumn Header="數量" Binding="{Binding Count}" Width="80" />
                        <DataGridTextColumn Header="比例" Binding="{Binding Ratio, StringFormat={}{0:P1}}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>

        <!-- 控制區域 -->
        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Background="White"
                Padding="12"
                CornerRadius="12"
                BorderBrush="#FFE0E0E0"
                BorderThickness="1">
            <DockPanel LastChildFill="True">
                <!-- 按鈕列優先配置空間 + WrapPanel 可換行 → 視窗變窄也不會被裁掉 -->
                <WrapPanel DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0">
                    <Button Content="開始 / 繼續"
                            Padding="18,8"
                            Margin="0,0,8,8"
                            Command="{Binding ToggleRunCommand}" />
                    <Button Content="暫停"
                            Padding="18,8"
                            Margin="0,0,8,8"
                            Command="{Binding PauseCommand}"
                            IsEnabled="{Binding IsRunning}" />
                    <Button Content="停止"
                            Padding="18,8"
                            Margin="0,0,8,8"
                            Background="{StaticResource NgRedBrush}"
                            Foreground="White"
                            Command="{Binding StopCommand}" />
                    <Button Content="查看歷史 →"
                            Padding="18,8"
                            Margin="0,0,0,8"
                            Background="#2D7D46"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding OpenHistoryCommand}"
                            ToolTip="前往歷史圖庫看剛跑的核對結果 / 混料" />
                </WrapPanel>
                <StackPanel Orientation="Vertical"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <!-- 雙 head 模型（承接自模型管理頁，不需在此重選）-->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,0,8">
                        <TextBlock Text="雙head模型"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Width="80" />
                        <TextBox Width="480"
                                 Text="{Binding PairModelDisplay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Foreground="#FF0E639C"
                                 Background="#FFF3F7FB"
                                 BorderThickness="0"
                                 Margin="0,0,8,0"
                                 ToolTip="使用目前在「模號穴號模型管理」載入的版本；要換版本請回該頁載入" />
                    </StackPanel>
                    <!-- 輸入資料夾 -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,0,8">
                        <TextBlock Text="輸入資料夾"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Width="80" />
                        <TextBox Width="400"
                                 Text="{Binding RootPath}"
                                 IsReadOnly="True"
                                 Margin="0,0,8,0" />
                        <Button Content="瀏覽..."
                                MinWidth="80"
                                Command="{Binding BrowseInputFolderCommand}" />
                    </StackPanel>
                    <!-- 輸出資料夾 -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="輸出資料夾"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Width="80" />
                        <TextBox Width="400"
                                 Text="{Binding OutputPath}"
                                 IsReadOnly="True"
                                 Margin="0,0,8,0" />
                        <Button Content="瀏覽..."
                                MinWidth="80"
                                Command="{Binding BrowseOutputFolderCommand}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Vertical"
                            VerticalAlignment="Center">
                    <ProgressBar Height="18"
                                 Width="280"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,6,0,0"
                               Foreground="#FF666666"
                               FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

