<Window x:Class="AIVision.Presentation.Wpf.Views.HistoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIVision.Presentation.Wpf.ViewModels"
        xmlns:converters="clr-namespace:AIVision.Presentation.Wpf.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="歷史圖庫"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        d:DataContext="{d:DesignInstance vm:HistoryViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <!-- Converters -->
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:NullToVisibilityInverseConverter x:Key="NullToVisibilityInverseConverter"/>
        <converters:NgToColorConverter x:Key="NgToColorConverter"/>
        <converters:OutcomeToColorConverter x:Key="OutcomeToColorConverter"/>
        <converters:PageIndexToBoolConverter x:Key="PageIndexToBoolConverter"/>
        <converters:PageIndexToDisplayConverter x:Key="PageIndexToDisplayConverter"/>
        <converters:CanGoNextPageConverter x:Key="CanGoNextPageConverter"/>

        <!-- 工單選擇器樣式 -->
        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 日期選擇器樣式 -->
        <Style x:Key="FilterDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 按鈕樣式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004578"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片樣式 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="8" ShadowDepth="2" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 檢測項目卡片樣式 -->
        <Style x:Key="InspectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="6" ShadowDepth="1" Direction="270"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 標題列 -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="檢測歷史圖庫" FontSize="24" FontWeight="Bold" Foreground="#333333"/>
                <TextBlock Text="查看和篩選歷史檢測記錄" FontSize="14" Foreground="#666666" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 篩選條件區 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第一行篩選 -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <!-- 工單篩選 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="工單：" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding WorkOrderCodes}"
                                  SelectedItem="{Binding SelectedWorkOrderCode}"
                                  Style="{StaticResource FilterComboBoxStyle}"/>
                    </StackPanel>

                    <!-- 日期範圍 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="開始日期：" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding FilterStartDate}"
                                    Style="{StaticResource FilterDatePickerStyle}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="結束日期：" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding FilterEndDate}"
                                    Style="{StaticResource FilterDatePickerStyle}"/>
                    </StackPanel>

                    <!-- 結果篩選（模號三態核對結果） -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="結果：" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <ComboBox SelectedValue="{Binding FilterResult}"
                                  SelectedValuePath="Tag"
                                  Style="{StaticResource FilterComboBoxStyle}" MinWidth="120">
                            <ComboBoxItem Content="全部" Tag="{x:Null}" IsSelected="True"/>
                            <ComboBoxItem Content="相符 (Match)" Tag="Match"/>
                            <ComboBoxItem Content="採信輸入 (TrustInput)" Tag="TrustInput"/>
                            <ComboBoxItem Content="混料警報 (MixedAlarm)" Tag="MixedAlarm"/>
                            <ComboBoxItem Content="略過 (Skip)" Tag="Skip"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 查詢按鈕 -->
                    <Button Content="查詢"
                            Command="{Binding QueryCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="8,0,0,0"/>
                </WrapPanel>

                <!-- 狀態訊息 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#666666"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="載入中..."
                               Foreground="#007ACC"
                               FontSize="13"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 檢測記錄列表 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding HistoryItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="220" Height="280" Style="{StaticResource InspectionCardStyle}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 圖片區 -->
                                    <Border Grid.Row="0" Background="#F0F0F0" CornerRadius="4">
                                        <Grid>
                                            <!-- 縮略圖 -->
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                            <!-- 無圖片提示 -->
                                            <TextBlock Text="無圖片"
                                                       FontSize="14"
                                                       Foreground="#AAAAAA"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityInverseConverter}}"/>

                                            <!-- 結果標籤（三態 Outcome 配色） -->
                                            <Border Background="{Binding Outcome, Converter={StaticResource OutcomeToColorConverter}}"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="8">
                                                <TextBlock Text="{Binding Outcome}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="14"/>
                                            </Border>

                                            <!-- 氣吹剔除指示 -->
                                            <Border Background="#CC000000"
                                                    CornerRadius="4"
                                                    Padding="6,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="8"
                                                    Visibility="{Binding AirBlown, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="氣吹剔除"
                                                           Foreground="#FFFF8A80"
                                                           FontWeight="Bold"
                                                           FontSize="11"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 資訊區 -->
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding WorkOrderCode}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="#333333"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Timestamp}"
                                                   FontSize="12"
                                                   Foreground="#666666"
                                                   Margin="0,4,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="預期：" FontSize="12" Foreground="#666666"/>
                                            <TextBlock Text="{Binding ExpectedCodeText}" FontSize="12" Foreground="#333333" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="讀到：" FontSize="12" Foreground="#666666"/>
                                            <TextBlock Text="{Binding ReadCodeText}" FontSize="12" Foreground="#333333" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="信心度：" FontSize="12" Foreground="#666666"/>
                                            <TextBlock Text="{Binding ConfidenceText}" FontSize="12" Foreground="#333333" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 分頁控制 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 上一頁 -->
                <Button Grid.Column="0"
                        Content="◀ 上一頁"
                        Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding CurrentPageIndex, Converter={StaticResource PageIndexToBoolConverter}}"/>

                <!-- 頁碼資訊 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="第 " FontSize="14" Foreground="#666666"/>
                    <TextBlock Text="{Binding CurrentPageIndex, Converter={StaticResource PageIndexToDisplayConverter}}"
                               FontSize="14" FontWeight="Bold" Foreground="#007ACC"/>
                    <TextBlock Text=" / " FontSize="14" Foreground="#666666"/>
                    <TextBlock Text="{Binding TotalPages}" FontSize="14" FontWeight="Bold" Foreground="#333333"/>
                    <TextBlock Text=" 頁，共 " FontSize="14" Foreground="#666666" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding TotalCount}" FontSize="14" FontWeight="Bold" Foreground="#333333"/>
                    <TextBlock Text=" 筆記錄" FontSize="14" Foreground="#666666"/>
                </StackPanel>

                <!-- 下一頁 -->
                <Button Grid.Column="2"
                        Content="下一頁 ▶"
                        Command="{Binding NextPageCommand}"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource CanGoNextPageConverter}">
                            <Binding Path="CurrentPageIndex"/>
                            <Binding Path="TotalPages"/>
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
