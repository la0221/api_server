<Window x:Class="AIVision.Presentation.Wpf.Views.ProjectLoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIVision.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="載入專案"
        Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        d:DataContext="{d:DesignInstance vm:ProjectLoadingViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="#FF1E1E1E"
            BorderBrush="#FF3F3F46"
            BorderThickness="1"
            CornerRadius="8"
            Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 標題 -->
                <RowDefinition Height="Auto"/>
                <!-- 分隔線 -->
                <RowDefinition Height="*"/>
                <!-- 設備狀態 -->
                <RowDefinition Height="Auto"/>
                <!-- 進度條 -->
                <RowDefinition Height="Auto"/>
                <!-- 狀態文字 -->
                <RowDefinition Height="Auto"/>
                <!-- 按鈕 -->
            </Grid.RowDefinitions>

            <!-- 標題 -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,15">
                <TextBlock Text="載入專案"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding ProjectName}"
                           FontSize="14"
                           Foreground="#FF007ACC"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- 分隔線 -->
            <Separator Grid.Row="1" Background="#FF3F3F46" Margin="0,0,0,20"/>

            <!-- 設備狀態列表 -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <!-- PLC -->
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0"
                             Width="16" Height="16"
                             Fill="{Binding PlcStatusColor}"/>
                    <TextBlock Grid.Column="1"
                               Text="PLC 連線"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding PlcError}"
                               Foreground="#FFFF6B6B"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- 相機 -->
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0"
                             Width="16" Height="16"
                             Fill="{Binding CameraStatusColor}"/>
                    <TextBlock Grid.Column="1"
                               Text="相機初始化"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding CameraError}"
                               Foreground="#FFFF6B6B"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- 光源 -->
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0"
                             Width="16" Height="16"
                             Fill="{Binding LightStatusColor}"/>
                    <TextBlock Grid.Column="1"
                               Text="光源連線"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding LightError}"
                               Foreground="#FFFF6B6B"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- AI 模型 -->
                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0"
                             Width="16" Height="16"
                             Fill="{Binding AiModelStatusColor}"/>
                    <TextBlock Grid.Column="1"
                               Text="AI 模型載入"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding AiModelError}"
                               Foreground="#FFFF6B6B"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </StackPanel>

            <!-- 進度條 -->
            <ProgressBar Grid.Row="3"
                         Value="{Binding Progress}"
                         Height="8"
                         Margin="0,20,0,10"
                         Background="#FF3F3F46"
                         Foreground="#FF007ACC"/>

            <!-- 狀態文字 -->
            <TextBlock Grid.Row="4"
                       Text="{Binding CurrentTask}"
                       Foreground="#FFCCCCCC"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- 按鈕 -->
            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding ShowButtons, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Content="重試失敗項目"
                        Command="{Binding RetryCommand}"
                        Visibility="{Binding HasFailure, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,0,10,0"
                        Padding="15,10"
                        Background="#FF3F3F46"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="繼續"
                        Command="{Binding ContinueCommand}"
                        IsEnabled="{Binding IsComplete}"
                        Padding="20,10"
                        Background="#FF007ACC"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
