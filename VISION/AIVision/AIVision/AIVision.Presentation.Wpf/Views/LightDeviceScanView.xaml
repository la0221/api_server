<Window x:Class="AIVision.Presentation.Wpf.Views.LightDeviceScanView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIVision.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LightDeviceScanViewModel}"
        Title="LTS 光源設備掃描與配置工具"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 標題 -->
        <TextBlock Grid.Row="0"
                   Text="LTS 光源設備掃描與重新配置工具"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- 掃描控制 -->
        <GroupBox Grid.Row="1" Header="掃描設備" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="掃描 IP 範圍:" Margin="0,0,0,8"/>
                <TextBox Text="{Binding ScanRange, Mode=TwoWay}"
                         Height="32"
                         FontSize="14"
                         Margin="0,0,0,12"
                         IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="快速掃描（常見 IP）"
                            Command="{Binding QuickScanCommand}"
                            Width="180"
                            Height="36"
                            Margin="0,0,12,0"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Content="完整掃描"
                            Command="{Binding ScanNetworkCommand}"
                            Width="120"
                            Height="36"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>

                <ProgressBar Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding Progress}"
                             Margin="0,0,0,8"/>

                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="Green"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <!-- 找到的設備列表 -->
        <GroupBox Grid.Row="2" Header="找到的設備" Padding="16" Margin="0,0,0,16">
            <DataGrid ItemsSource="{Binding FoundDevices}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="IP 地址" Binding="{Binding IpAddress}" Width="150"/>
                    <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="80"/>
                    <DataGridTextColumn Header="通道數" Binding="{Binding ChannelCount}" Width="80"/>
                    <DataGridTextColumn Header="狀態" Binding="{Binding Status}" Width="*"/>
                    <DataGridTemplateColumn Header="操作" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="選擇"
                                        Command="{Binding DataContext.SelectDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Height="28"
                                        Width="80"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 設備配置 -->
        <GroupBox Grid.Row="3" Header="設備配置與重新配置" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="當前設備 IP:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox Text="{Binding TargetDeviceIp, Mode=TwoWay}"
                             Height="32"
                             Width="200"
                             FontSize="14"
                             Margin="0,0,12,0"/>
                    <Button Content="讀取配置"
                            Command="{Binding ReadDeviceConfigCommand}"
                            Height="32"
                            Width="100"/>
                </StackPanel>

                <!-- 當前配置顯示 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding CurrentConfig}"
                           Background="#FFF0F0F0"
                           Padding="12"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="新設備 IP:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding NewDeviceIp, Mode=TwoWay}"
                         Height="32"
                         FontSize="14"
                         Margin="0,0,0,12"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="新網關 IP:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding NewGateway, Mode=TwoWay}"
                         Height="32"
                         FontSize="14"
                         Margin="0,0,0,12"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="端口:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                <TextBox Grid.Row="4" Grid.Column="1"
                         Text="{Binding NewPort, Mode=TwoWay}"
                         Height="32"
                         FontSize="14"
                         Margin="0,0,0,12"/>

                <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                        Content="⚠️ 執行重新配置（設備將重啟）"
                        Command="{Binding ReconfigureDeviceCommand}"
                        Height="40"
                        Background="Orange"
                        Foreground="White"
                        FontWeight="Bold"/>
            </Grid>
        </GroupBox>

        <!-- 使用說明 -->
        <Border Grid.Row="4"
                Background="#FFF8F8F8"
                Padding="16"
                CornerRadius="4"
                BorderBrush="#FFCCCCCC"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="使用說明" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap">
                    <Run Text="1. 點擊「快速掃描」嘗試常見 IP，或使用「完整掃描」掃描整個網段"/>
                    <LineBreak/>
                    <Run Text="2. 找到設備後，點擊「選擇」按鈕（會自動讀取配置）"/>
                    <LineBreak/>
                    <Run Text="3. 查看當前配置，確認是否需要修改"/>
                    <LineBreak/>
                    <Run Text="4. 填寫新的網路參數（建議設定為 192.168.10.10）"/>
                    <LineBreak/>
                    <Run Text="5. 點擊「執行重新配置」，設備將重啟"/>
                    <LineBreak/>
                    <Run Text="6. 等待 10 秒後，使用新 IP 連接設備"/>
                    <LineBreak/>
                    <LineBreak/>
                    <Run Text="⚠️ 注意：只會設定設備 IP、網關、端口，不設定服務器參數" FontWeight="Bold" Foreground="Orange"/>
                    <LineBreak/>
                    <Run Text="⚠️ 重新配置會立即重啟設備，請確認參數正確！" FontWeight="Bold" Foreground="Red"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
