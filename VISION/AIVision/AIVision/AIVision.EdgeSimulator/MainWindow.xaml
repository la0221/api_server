<Window x:Class="AIVision.EdgeSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edge 模擬器（獨立·零依賴·純 HTTP）" Height="640" Width="980"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E">
    <DockPanel Margin="12">

        <!-- 連線列 -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Server：" Foreground="#9CDCFE" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtServer" Text="http://localhost:5030" Width="230" Margin="0,0,12,0"
                     VerticalAlignment="Center"/>
            <TextBlock Text="stationId：" Foreground="#9CDCFE" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtStation" Text="ST-01" Width="80" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <Button x:Name="BtnHealth" Content="健康檢查" Click="BtnHealth_Click"
                    Padding="12,5" Margin="0,0,8,0" Background="#3A3D41" Foreground="#D4D4D4" BorderThickness="0"/>
            <Button x:Name="BtnSingle" Content="選圖並送出" Click="BtnSingle_Click"
                    Padding="12,5" Margin="0,0,8,0" Background="#0E639C" Foreground="White" BorderThickness="0"/>
            <Button x:Name="BtnFolder" Content="選資料夾批量（線下模式）" Click="BtnFolder_Click"
                    Padding="12,5" Margin="0,0,8,0" Background="#2D7D46" Foreground="White" BorderThickness="0"/>
            <Button x:Name="BtnStop" Content="停止" Click="BtnStop_Click" IsEnabled="False"
                    Padding="12,5" Background="#A1260D" Foreground="White" BorderThickness="0"/>
        </WrapPanel>

        <!-- 狀態列 -->
        <Border DockPanel.Dock="Top" Background="#252526" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <TextBlock x:Name="TxtStatus" Text="尚未連線。流程：健康檢查 → 選圖/資料夾送出 → 右側就是 edge 收到的原始回應。"
                       Foreground="#D4D4D4" FontSize="13" TextWrapping="Wrap"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：解析摘要 + 動作示意 -->
            <Border Grid.Column="0" Background="#252526" CornerRadius="4" Padding="10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="解析摘要（edge 拿 JSON 後的判讀）" Foreground="#9CDCFE" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtSummary" Text="—" Foreground="White" FontSize="15"
                               TextWrapping="Wrap" LineHeight="24"/>
                    <Border Background="#1B1B1B" CornerRadius="4" Padding="8" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="動作示意（edge 端規則：模號信心≥0.60 且 穴號信心≥0.85）"
                                       Foreground="#808080" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtAction" Text="—" FontSize="18" FontWeight="Bold"
                                       Foreground="#D4D4D4"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TxtBatchStats" Text="" Foreground="#4EC9B0" FontSize="12"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 右：原始 JSON -->
            <Border Grid.Column="1" Background="#252526" CornerRadius="4" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="原始回應（edge 實際收到的 JSON）"
                               Foreground="#9CDCFE" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtJson" IsReadOnly="True" Background="#1B1B1B" Foreground="#4EC9B0"
                             FontFamily="Consolas" FontSize="12" BorderThickness="0"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
