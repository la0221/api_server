<Window x:Class="AIVision.Presentation.Server.Views.RecordDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIVision.Presentation.Server.ViewModels"
        mc:Ignorable="d"
        Title="收件詳細"
        Width="900"
        Height="680"
        MinWidth="720"
        MinHeight="520"
        Background="{StaticResource BackgroundGrayBrush}"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance vm:RecordDetailViewModel, IsDesignTimeCreatable=False}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 標題：讀值最大，一眼看到 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#FF999999" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Reading}" FontSize="26" FontWeight="Bold" Foreground="#FF333333" />
                        <Border CornerRadius="4" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFEEEEEE" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOk}" Value="True">
                                            <Setter Property="Background" Value="#FFE8F6EC" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NeedsReview}" Value="True">
                                            <Setter Property="Background" Value="#FFFBF3E0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#FF555555" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- 左：條列式全部欄位 -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="這一筆的細節" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#FF444444" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="12" Foreground="#FF888888"
                                                   VerticalAlignment="Top">
                                            <Run Text="•  " /><Run Text="{Binding Label, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                                   Foreground="#FF333333" TextWrapping="Wrap"
                                                   ToolTip="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右：父端實際收到的影像 -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="父端收到的影像" FontSize="15" FontWeight="SemiBold"
                               Foreground="#FF444444" Margin="0,0,0,12" />

                    <Border Grid.Row="1" Background="#FF2D2D30" CornerRadius="8" Padding="8">
                        <Image Source="{Binding Image}" Stretch="Uniform" />
                    </Border>

                    <TextBlock Grid.Row="2" Text="{Binding ImageNote}" FontSize="11" Foreground="#FF888888"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
