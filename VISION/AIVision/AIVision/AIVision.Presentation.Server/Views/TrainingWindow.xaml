<Window x:Class="AIVision.Presentation.Server.Views.TrainingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AIVision.Presentation.Server.ViewModels"
        mc:Ignorable="d"
        Title="自我強化訓練"
        Width="1180"
        Height="780"
        MinWidth="960"
        MinHeight="640"
        Background="{StaticResource BackgroundGrayBrush}"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance vm:TrainingViewModel, IsDesignTimeCreatable=False}">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FF2196F3" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1976D2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FFBDBDBD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PublishButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FF16A34A" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FF7F1D1D" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF888888" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="80" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 標題 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="自我強化訓練" FontSize="20" FontWeight="Bold" Foreground="#FF333333" />
                    <TextBlock FontSize="12" Foreground="#FF888888" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="產線抓到的混料圖自帶正解（exp_ 後面就是答案），拿它回頭補強模型。流程：選資料集 → 訓練 → 過驗證閘門 → 你按上架。訓練永不覆蓋現有權重。" />
                </StackPanel>
                <TextBlock Text="{Binding LastCheckedText}" FontSize="11" Foreground="#FF999999"
                           HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <!-- 現況 + 新訓練 -->
        <Border Grid.Row="1" Background="White" CornerRadius="0" Padding="18,14" Margin="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Ellipse Width="12" Height="12" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FFCCCCCC" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource OkGreenBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Busy}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentOrangeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusNote}" FontSize="13" Foreground="#FF444444"
                               Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="{Binding GateText}" FontSize="11" Foreground="#FF999999" Margin="20,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,14,0">
                        <TextBlock Text="用途" Style="{StaticResource Label}" Width="40" />
                        <ComboBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                                  Width="110" Height="30" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0"
                                IsEnabled="{Binding NeedsHead}">
                        <TextBlock Text="head" Style="{StaticResource Label}" Width="40" />
                        <ComboBox ItemsSource="{Binding Heads}" SelectedItem="{Binding SelectedHead}"
                                  Width="100" Height="30" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,14,0">
                        <TextBlock Text="資料集" Style="{StaticResource Label}" Width="50" />
                        <ComboBox ItemsSource="{Binding Datasets}" SelectedItem="{Binding SelectedDataset}"
                                  DisplayMemberPath="Summary"
                                  Width="220" Height="30" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,14,0">
                        <TextBlock Text="run 名稱" Style="{StaticResource Label}" Width="60" />
                        <TextBox Text="{Binding RunName, UpdateSourceTrigger=PropertyChanged}"
                                 Width="180" Height="30" VerticalContentAlignment="Center" Padding="6,0" />
                        <TextBlock Text="備註" Style="{StaticResource Label}" Width="40" Margin="12,0,0,0" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="160" Height="30" VerticalContentAlignment="Center" Padding="6,0" />
                    </StackPanel>

                    <Button Grid.Column="4" Content="開始訓練" Command="{Binding StartCommand}"
                            IsEnabled="{Binding Enabled}"
                            Style="{StaticResource PrimaryButton}" FontSize="14" FontWeight="SemiBold" />
                </Grid>

                <TextBlock FontSize="11" Foreground="#FFAAAAAA" Margin="0,8,0,0" TextWrapping="Wrap">
                    <Run Text="資料集位置：" /><Run Text="{Binding DatasetRoot, Mode=OneWay}" />
                    <Run Text="　訓練輸出：" /><Run Text="{Binding OutputRoot, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- run 清單 + 執行紀錄 -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="480" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="訓練紀錄" FontSize="15" FontWeight="SemiBold"
                               Foreground="#FF444444" Margin="0,0,0,10" />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#FFEEEEEE" BorderThickness="0"
                              Background="Transparent" RowBackground="White"
                              AlternatingRowBackground="#FFFAFBFC" FontSize="13">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                        <Setter Property="Background" Value="#FFFBF3E0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                        <Setter Property="Background" Value="#FFFDECE9" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CanPublish}" Value="True">
                                        <Setter Property="Background" Value="#FFE8F6EC" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="時間" Binding="{Binding CreatedText}" Width="90" />
                            <DataGridTextColumn Header="run" Binding="{Binding Id}" Width="*" />
                            <DataGridTextColumn Header="用途" Binding="{Binding Task}" Width="80" />
                            <DataGridTextColumn Header="head" Binding="{Binding Head}" Width="70" />
                            <DataGridTextColumn Header="狀態" Binding="{Binding StateText}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="量測" Binding="{Binding MetricsText}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <TextBlock Text="上架不等於啟用——之後還要到模型池按「設為現用」"
                                   FontSize="11" Foreground="#FF999999"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Content="取消訓練" Command="{Binding CancelCommand}"
                                Style="{StaticResource DangerButton}" FontSize="13" />
                        <Button Content="上架這個候選" Command="{Binding PublishCommand}"
                                Style="{StaticResource PublishButton}" FontSize="13"
                                FontWeight="SemiBold" Margin="10,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="執行紀錄" FontSize="15" FontWeight="SemiBold"
                               Foreground="#FF444444" Margin="0,0,0,10" />
                    <Border Grid.Row="1" Background="#FF1E1E1E" CornerRadius="8" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding SelectedRunLog, Mode=OneWay}"
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="#FFD4D4D4" FontFamily="Consolas" FontSize="12"
                                     TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#FF2D2D30" Padding="16,8">
            <TextBlock Text="{Binding ActionMessage}" Foreground="#FFDDDDDD" FontSize="12" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
