<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- 中央推論機（父端）專用程式：與站端 App 分開安裝、各自獨立執行。 -->
    <AssemblyName>AIVisionServerConsole</AssemblyName>
    <Product>AIVision 中央推論監控</Product>
    <Company>Your Company</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只依賴 Infrastructure（取 CrnnInferClient / InferenceServerOptions）；
         不依賴站端的 Presentation.Wpf，兩程式互不相干。 -->
    <ProjectReference Include="..\AIVision.Infrastructure\AIVision.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 版本與站端 App／Infrastructure 對齊，避免解析衝突。 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
